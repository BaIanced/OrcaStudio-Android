# Build outputs live in ~/build/orca-android (see README); keep stray local artifacts out.
*.apk
*.so
.stfolder/
.stignore
# Claude Code: the shared hook (privacy scan) is tracked, local settings are not.
.claude/*
!.claude/settings.json
!.claude/hooks/
# Release outputs and signing secrets
dist/
android/key.properties
*.jks
*.keystore
.kotlin/
