+bool TriangleSelector::HeightRange::claims_leaf(const Triangle& tr, const std::vector<Vertex>& vertices) const
+{
+    const Vec3f c = (vertices[tr.verts_idxs[0]].v + vertices[tr.verts_idxs[1]].v + vertices[tr.verts_idxs[2]].v) / 3.f;
+    const float z = (this->trafo * c).z();
+    return z >= m_z_world && z < m_z_world + m_height;
