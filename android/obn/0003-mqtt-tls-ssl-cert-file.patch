+            // SSL_CERT_FILE first, as OpenSSL's own default lookup does: Android
+            // has none of the paths below, and its app exports the system CA
+            // store to a PEM bundle named there. (OrcaStudio-ARM patch 0003.)
+            if (const char* e = std::getenv("SSL_CERT_FILE"); e && *e) {
+                FILE* f = std::fopen(e, "rb");
+                if (f) { std::fclose(f); trust_bundle = e; cafile = trust_bundle.c_str(); }
+            }
             for (const char* p : kCaCandidates) {
+                if (cafile) break;
                 FILE* f = std::fopen(p, "rb");
                 if (f) { std::fclose(f); cafile = p; break; }
             }
