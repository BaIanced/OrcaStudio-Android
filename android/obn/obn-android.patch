-add_library(bambu_networking SHARED
+# Android embedding (Orca-Android): build the agent as a static library that
+# is linked into the app's own JNI library, so both share one libc++ and the
+# std::string / std::function ABI crosses no shared-library boundary.
+option(OBN_EMBED_STATIC "Build bambu_networking as a static library and skip the desktop plugin extras (BambuSource, live555, install, conf patching)" OFF)
+if(OBN_EMBED_STATIC)
+    set(_obn_lib_type STATIC)
+else()
+    set(_obn_lib_type SHARED)
+endif()
+add_library(bambu_networking ${_obn_lib_type}
     src/abi_meta.cpp
     src/abi_lifecycle.cpp
     src/abi_callbacks.cpp
